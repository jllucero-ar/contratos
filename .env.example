# AI provider: anthropic | openai | gemini (default: anthropic)
IA_PROVEEDOR=anthropic

# Optional: override the default model of the selected provider
# IA_MODELO=

# Max output tokens per call (default: 8000)
IA_MAX_TOKENS=8000

# API key for the provider you selected (only that one is required)
ANTHROPIC_API_KEY=your-key-here
OPENAI_API_KEY=
GEMINI_API_KEY=
